{
  "name": "t3-mb-template",
  "private": true,
  "engines": {
    "node": ">=22.22.3",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev --filter=@acme/nextjs --filter=@acme/api --parallel --no-cache",
    "dev:api": "turbo run dev --filter=@acme/api --no-cache",
    "dev:next": "turbo run dev --filter=@acme/nextjs --no-cache",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "turbo run test --continue",
    "test:gates": "bash scripts/hooks.test.sh && bash scripts/ai-review.test.sh && node scripts/review-map.test.mjs && node scripts/review-map.mjs check",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@turbo/gen": "^2.11.6",
    "dotenv-cli": "^11.0.0",
    "prettier": "catalog:",
    "turbo": "^2.11.6",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
