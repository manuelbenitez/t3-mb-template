    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "catalog:",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "catalog:"
